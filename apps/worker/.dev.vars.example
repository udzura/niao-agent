# Generate a random value: openssl rand -hex 32
NIAO_TOKEN=

# Optional: account-wide Workers AI, Workers and Durable Objects usage (see docs/usage.md).
# Permission: Account > Account Analytics > Read
# Additional permission for Workers Free/Paid verification: Account > Billing > Read
CF_ACCOUNT_ID=
CF_ANALYTICS_TOKEN=

# Optional Past Logs MCP (read-only token from apps/past-logs/.dev.vars).
PAST_LOGS_MCP_URL=http://127.0.0.1:8788/mcp
PAST_LOGS_MCP_TOKEN=
