{
  "name": "@niao/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev -c wrangler.jsonc -c ../ruby-runner/wrangler.jsonc -c ../tools-misc/wrangler.jsonc --ip 127.0.0.1",
    "build": "wrangler deploy --dry-run --outdir build",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pretest": "npm run build -w @niao/ruby-runner && npm run build -w @niao/past-logs && npm run build -w @niao/tools-misc"
  },
  "dependencies": {
    "agents": "0.31.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.8",
    "@cloudflare/workers-types": "latest",
    "typescript": "latest",
    "vitest": "~4.1.0",
    "wrangler": "4.153.0"
  }
}
