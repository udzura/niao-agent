{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "niao-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {"CHAT_RETENTION_DAYS":"30"},
  "services": [
    {
      "binding": "RUBY_RUNNER",
      "service": "niao-ruby-runner"
    },
    {
      "binding": "TOOLS_MISC",
      "service": "niao-tools-misc"
    }
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "queues": {
    "producers": [{"binding":"FETCH_JOBS","queue":"niao-fetch-jobs"}],
    "consumers": [{"queue":"niao-fetch-jobs","max_batch_size":1,"max_batch_timeout":1,
      "max_concurrency":1,"max_retries":5,"dead_letter_queue":"niao-fetch-jobs-dlq"}]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "NiaoAgent",
        "class_name": "NiaoAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "NiaoAgent"
      ]
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
