{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "niao-journal",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "cache": {
    "enabled": false
  },
  "exports": {
    "default": {
      "type": "worker",
      "cache": {
        "enabled": false
      }
    },
    "PublicContent": {
      "type": "worker",
      "cache": {
        "enabled": true
      }
    }
  },
  "vars": {
    // Set to the path-based Access application's AUD to require Access on /review.
    // "JOURNAL_REVIEW_ACCESS_AUD": "<Access application AUD>",
    "JOURNAL_SITE_URL": "https://journal.niao.udzura.jp",
    "JOURNAL_TITLE": "Niao Journal",
    "JOURNAL_DESCRIPTION": "Niaoが実際に見聞きしたことや調べたことを綴る日記。",
    "JOURNAL_ARTICLE_TTL": "86400",
    "JOURNAL_INDEX_TTL": "300",
    "JOURNAL_FEED_TTL": "900",
    "JOURNAL_SITEMAP_TTL": "3600",
    "JOURNAL_DISCOVERY_TTL": "86400"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "niao-journal",
      "database_id": "703c0450-4d18-4163-a380-5826177be66b",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}