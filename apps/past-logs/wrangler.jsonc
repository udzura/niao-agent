{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "niao-past-logs",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "niao-past-logs",
      "remote": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "niao-past-logs",
      // Replace after `wrangler d1 create niao-past-logs`; never a credential.
      "database_id": "dd9fd963-dfca-4929-a026-eff77c2b39cb",
      "migrations_dir": "migrations"
    },
    {
      "binding": "niao_past_logs",
      "database_name": "niao-past-logs",
      "database_id": "dd9fd963-dfca-4929-a026-eff77c2b39cb",
      "remote": true
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "vars": {
    "COSENSE_PROJECT_NAME": "udzura-lofi-memo",
    "COSENSE_SYNC_ENABLED": "true"
  },
  "queues": {
    "producers": [
      {
        "binding": "COSENSE_SYNC_QUEUE",
        "queue": "niao-cosense-sync"
      }
    ],
    "consumers": [
      {
        "queue": "niao-cosense-sync",
        "max_batch_size": 1,
        "max_concurrency": 1,
        "max_retries": 5,
        "dead_letter_queue": "niao-cosense-sync-dlq"
      }
    ]
  },
  "env": {
    "development": {
      "triggers": {
        "crons": []
      },
      "vars": {
        "COSENSE_PROJECT_NAME": "udzura-lofi-memo",
        "COSENSE_SYNC_ENABLED": "false"
      },
      "queues": {
        "producers": [
          {
            "binding": "COSENSE_SYNC_QUEUE",
            "queue": "niao-cosense-sync-dev"
          }
        ],
        "consumers": [
          {
            "queue": "niao-cosense-sync-dev",
            "max_batch_size": 1,
            "max_concurrency": 1,
            "max_retries": 5,
            "dead_letter_queue": "niao-cosense-sync-dev-dlq"
          }
        ]
      },
      "ai": {
        "binding": "AI",
        "remote": true
      },
      "vectorize": [
        {
          "binding": "VECTORIZE",
          "index_name": "niao-past-logs-dev",
          "remote": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "niao-past-logs-dev",
          "database_id": "dd9fd963-dfca-4929-a026-eff77c2b39cb",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}