{
  "name": "@niao/past-logs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env development --ip 127.0.0.1 --port 8788",
    "build": "wrangler deploy --env \"\" --dry-run --outdir build",
    "deploy": "wrangler deploy --env \"\"",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:importers && vitest run",
    "db:migrate": "wrangler d1 migrations apply DB --local --env development",
    "import:sample": "node scripts/import-samples.mjs",
    "test:dev": "node scripts/smoke.mjs",
    "dev:offline": "wrangler dev -c wrangler.offline.jsonc --ip 127.0.0.1 --port 8788",
    "reindex": "node scripts/reindex.mjs",
    "test:semantic:live": "node scripts/semantic-smoke.mjs",
    "import:cosense": "node scripts/import-cosense.mjs",
    "test:importers": "node --test scripts/test/*.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "agents": "0.31.0",
    "fast-xml-parser": "^5.11.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.8",
    "@cloudflare/workers-types": "latest",
    "@modelcontextprotocol/client": "2.3.1",
    "typescript": "latest",
    "vitest": "~4.1.0",
    "wrangler": "4.153.0"
  }
}
