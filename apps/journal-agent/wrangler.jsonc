{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "niao-journal-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "ai": {"binding":"AI","remote":true},
  "services": [{"binding":"JOURNAL","service":"niao-journal"}],
  "durable_objects": {"bindings":[
    {"name":"JournalAgent","class_name":"JournalAgent"},
    {"name":"NiaoAgent","class_name":"NiaoAgent","script_name":"niao-agent"}
  ]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["JournalAgent"]}],
  "queues": {
    "producers":[{"binding":"JOURNAL_RESULTS","queue":"niao-journal-results"}],
    "consumers":[{"queue":"niao-journal-prompts","max_batch_size":1,"max_batch_timeout":1,"max_concurrency":1,"max_retries":5,"dead_letter_queue":"niao-journal-prompts-dlq"}]
  },
  "observability":{"logs":{"enabled":true,"invocation_logs":true}}
}
