{
  "name": "@niao/journal-agent",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 8792",
    "build": "wrangler deploy --dry-run --outdir build",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build -w @niao/journal"
  },
  "dependencies": {
    "agents": "0.31.0",
    "zod": "4.6.7",
    "@modelcontextprotocol/client": "2.3.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.8",
    "@cloudflare/workers-types": "latest",
    "typescript": "latest",
    "vitest": "~4.1.0",
    "wrangler": "4.153.0"
  }
}
