{
  "name": "niao-agent",
  "private": true,
  "workspaces": [
    "apps/worker",
    "apps/ruby-runner"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/worker",
    "test": "npm run test -w apps/worker",
    "test:macos": "swift test --package-path apps/macos",
    "typecheck": "npm run typecheck --workspaces",
    "build:worker": "npm run build -w apps/worker",
    "build:macos": "bash apps/macos/scripts/build.sh",
    "build:ruby": "bash tools/ruby-sandbox/build.sh",
    "build:runner": "npm run build -w apps/ruby-runner",
    "bench:ruby": "node tools/ruby-sandbox/bench.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.1"
  }
}
